# Pooled PostgreSQL URL used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST:5432/DATABASE?sslmode=verify-full"
# Direct PostgreSQL URL used by Prisma migrations and generation.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=verify-full"

BETTER_AUTH_SECRET="generate-a-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional comma-separated additional origins, such as an intentional legacy host.
BETTER_AUTH_TRUSTED_ORIGINS=""

# Stripe credentials are server-only. Never prefix them with NEXT_PUBLIC_.
# NEXT_PUBLIC_APP_URL must be the public HTTPS production origin.
STRIPE_SECRET_KEY="sk_test_"
STRIPE_WEBHOOK_SECRET="whsec_"

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Reserved for a future separate preview-only bucket/CDN. Keep blank while
# originals and previews share the same private bucket.
R2_PUBLIC_URL=""

# Used only by the admin bootstrap seed.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
